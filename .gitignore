.env
.idea/
__pycache__/
*.pyc
.venv/
*.db
*.db.bak
.DS_Store
android/.gradle/
android/build/
android/app/build/
android/local.properties

# Large model artifacts (>25 MB)
*.bin
*.pt
*.pth
*.onnx
*.safetensors
ml/artifacts/*.bin
ml/artifacts/*.pt
ml/artifacts/*.safetensors
ml/artifacts/large_*

ml/guardrail_eval/data/*_prompts.jsonl

# LLM evaluation cache (never committed)
ml/results/llm_cache.jsonl

# Intake miss log (runtime, masked; never committed)
ml/results/lexicon_misses.jsonl

# Generated symptom-embedding index (rebuilt lazily at first use)
ml/artifacts/symptom_embeddings.joblib

# External datasets/repos (downloaded, never committed)
ml/external/raw/
ml/external/*.csv
!ml/external/hinglish_candidates.csv
!ml/external/pseudo_review.csv
ml/external/mmcqs_fewshot.json
ml/external/selftrain_results.json

ml/results/reconciliation.log
