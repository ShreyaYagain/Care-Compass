# DeepSeek (primary LLM — OpenAI-compatible chat completions)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_S=3.0

HOST=0.0.0.0
PORT=8000
DEBUG=False
MODEL_VERSION=1.0.0
DATABASE_URL=sqlite:///./carecompass.db

# Supabase (Postgres + Auth). Leave empty to use the local SQLite fallback.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
ENV=dev
DEV_USER_ID=
