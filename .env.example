# LLM provider (OpenAI-compatible chat completions).
# provider = deepseek | groq
LLM_PROVIDER=deepseek
LLM_BASE_URL=
LLM_MODEL=deepseek-v4-pro
LLM_FAST_MODEL=deepseek-flash
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Speech-to-text: groq_whisper | local_whisper | android_only
STT_PROVIDER=

LLM_TIMEOUT_S=3.0

HOST=0.0.0.0
PORT=8000
DEBUG=False
MODEL_VERSION=1.0.0
DATABASE_URL=sqlite:///./carecompass.db

# Supabase (Postgres + Auth). Leave empty to use the local SQLite fallback.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
ENV=dev
DEV_USER_ID=
